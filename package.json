{
  "name": "esp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ESP — évolution économique d'agents autonomes sous contraintes de ressources",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && pnpm --filter @esp/tableau-de-bord typecheck",
    "test": "vitest run",
    "build": "pnpm -r --sort run build",
    "dev:tableau-de-bord": "pnpm --filter @esp/tableau-de-bord dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
